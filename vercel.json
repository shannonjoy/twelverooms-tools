{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.py": {
      "includeFiles": "api/_*/**"
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.thetwelverooms.com" }],
      "destination": "https://thetwelverooms.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/moon/:date", "destination": "/api/moon_day?date=:date" },
    { "source": "/void-of-course-moon/:date", "destination": "/api/voc_day?date=:date" },
    { "source": "/saturn-return/:year", "destination": "/api/saturn?year=:year" },
    { "source": "/big-3/:combo", "destination": "/api/saturn?combo=:combo" }
  ],
  "headers": [
    {
      "source": "/calendar/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=21600" }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
